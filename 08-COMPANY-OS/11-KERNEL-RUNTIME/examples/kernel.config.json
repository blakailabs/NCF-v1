{
  "cfhs_version": "0.1",
  "principals": [
    {
      "id": "human:owner",
      "type": "human",
      "active": true,
      "capabilities": [
        {"id":"cap-owner-all","action":"*","resource":"*"},
        {"id":"cap-approve-elevation","action":"kernel.elevation.approve","resource":"*"},
        {"id":"cap-issue-session","action":"kernel.session.issue","resource":"/sys/identity/sessions"},
        {"id":"cap-supervise-process","action":"kernel.process.supervise","resource":"/proc/*"}
      ]
    },
    {
      "id": "human:risk",
      "type": "human",
      "active": true,
      "capabilities": [
        {"id":"cap-action-approve-risk","action":"kernel.action.approval.approve","resource":"/run/actions/approvals/*"}
      ]
    },
    {
      "id": "human:finance",
      "type": "human",
      "active": true,
      "capabilities": [
        {"id":"cap-action-approve-finance","action":"kernel.action.approval.approve","resource":"/run/actions/approvals/*"}
      ]
    },
    {
      "id": "agent:ops",
      "type": "agent",
      "active": true,
      "capabilities": [
        {"id":"cap-mail-send","action":"mail.send","resource":"/dev/mail/primary","conditions":{"resource_type":"outbound_messages","hard_limit":100}},
        {"id":"cap-refund","action":"payments.refund","resource":"/dev/payments/primary","conditions":{"max_amount":250}},
        {"id":"cap-http-readonly","action":"http.get","resource":"/dev/http/readonly"},
        {"id":"cap-github-readonly","action":"github.repo.read","resource":"/dev/github/readonly"},
        {"id":"cap-event-publish","action":"event.publish","resource":"/run/ipc/company.*"},
        {"id":"cap-event-consume","action":"event.consume","resource":"/run/ipc/company.*"},
        {"id":"cap-action-intent-create","action":"kernel.action.intent.create","resource":"/run/actions/intents"},
        {"id":"cap-action-approval-request","action":"kernel.action.approval.request","resource":"/run/actions/*"},
        {"id":"cap-action-compensation-declare","action":"kernel.action.compensation.declare","resource":"/run/actions/*"}
      ]
    }
  ],
  "devices": [
    {
      "id":"mail-primary",
      "resource":"/dev/mail/primary",
      "provider":"mock-mail",
      "operations":[
        {
          "name":"mail.send",
          "side_effect_class":"S2",
          "idempotency_required":true,
          "resource_type":"outbound_messages",
          "action_safety":{
            "resource_pool_id":"outbound-message-budget",
            "resource_amount_argument":"resource_amount",
            "minimum_approvals":0
          }
        }
      ]
    },
    {
      "id":"payments-primary",
      "resource":"/dev/payments/primary",
      "provider":"sandbox-payments",
      "operations":[
        {
          "name":"payments.refund",
          "side_effect_class":"S3",
          "idempotency_required":true,
          "action_safety":{
            "resource_pool_id":"refund-budget",
            "resource_amount_argument":"amount",
            "minimum_approvals":2
          },
          "live_adapter_safety":{
            "provider_id":"sandbox-payments",
            "sandbox_only":true,
            "exact_resource":{
              "pool_id":"refund-usd-minor",
              "argument":"amount",
              "unit_kind":"currency_minor",
              "currency":"USD",
              "minor_exponent":2
            },
            "compensation":{
              "device_id":"payments-primary",
              "operation":"payments.refund.reverse",
              "authorization_action":"payments.refund.reverse"
            }
          }
        },
        {
          "name":"payments.refund.reverse",
          "side_effect_class":"S3",
          "idempotency_required":true,
          "live_adapter_safety":{
            "provider_id":"sandbox-payments",
            "sandbox_only":true
          }
        }
      ]
    },
    {
      "id":"http-readonly",
      "resource":"/dev/http/readonly",
      "provider":"sandboxed-http",
      "operations":[{"name":"http.get","side_effect_class":"S0","idempotency_required":false}]
    },
    {
      "id":"github-readonly",
      "resource":"/dev/github/readonly",
      "provider":"github-api",
      "operations":[{"name":"github.repo.read","side_effect_class":"S0","idempotency_required":false}]
    }
  ]
}
